---
import { getT, type Locale } from "@app/i18n/translations";
import { getLocalizedProjects } from "@work/data/projects";
import StatusPill from "@shared/ui/StatusPill.astro";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;
const t = getT(locale);
const projects = getLocalizedProjects(locale);
---

<section class="px-4 pb-20 pt-28 sm:px-6 sm:pb-28 sm:pt-32" aria-labelledby="hero-title">
  <div class="mx-auto grid w-full max-w-[1200px] items-center gap-12 lg:grid-cols-[0.92fr_1.08fr]">
    <div data-animate>
      <a class="inline-flex items-center gap-2 text-[13px] text-mist no-underline" href="#projects">
        <span class="size-1 rounded-full bg-accent"></span>
        <span>{t("hero.availability")}</span>
        <span class="text-fog">{t("hero.focus")}</span>
      </a>
      <p class="mt-8 text-xs font-[510] uppercase text-fog">{t("hero.role")}</p>
      <h1 id="hero-title" class="mt-4 max-w-3xl text-6xl font-light leading-none tracking-normal text-snow max-md:text-5xl max-sm:text-4xl">
        {t("hero.headline")}
      </h1>
      <p class="mt-6 max-w-2xl text-[17px] leading-[1.6] text-fog">
        {t("hero.summary")}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded-md bg-accent px-4 py-2 text-sm font-[510] text-snow no-underline shadow-button-stack" href="#projects">
          {t("hero.primary")}
        </a>
        <a class="rounded-md border border-graphite px-4 py-2 text-sm text-mist no-underline transition hover:border-iron hover:text-snow" href="#contact">
          {t("hero.secondary")}
        </a>
      </div>
      <dl class="mt-10 grid max-w-xl gap-3 sm:grid-cols-3">
        {[
          { label: t("hero.metric.focusLabel"), value: t("hero.metric.focusValue") },
          { label: t("hero.metric.locationLabel"), value: t("hero.metric.locationValue") },
          { label: t("hero.metric.availabilityLabel"), value: t("hero.metric.availabilityValue") },
        ].map((metric) => (
          <div class="rounded-md border border-graphite bg-onyx p-3 shadow-inset-line">
            <dt class="text-xs text-slate">{metric.label}</dt>
            <dd class="mt-1 text-sm font-[510] text-snow">{metric.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="rounded-xl bg-charcoal p-3 shadow-product shadow-inset-line" data-animate="panel">
      <div class="rounded-lg border border-graphite bg-onyx">
        <div class="flex items-center justify-between border-b border-graphite px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-crimson"></span>
            <span class="size-2 rounded-full bg-slate"></span>
            <span class="size-2 rounded-full bg-emerald"></span>
          </div>
          <span class="mono text-xs text-slate">engineering.profile</span>
        </div>
        <div class="grid gap-3 p-4">
          <div class="rounded-md bg-steel px-3 py-2 text-sm text-slate shadow-md">
            {t("hero.search")}
          </div>
          {projects.map((project) => (
            <article class="rounded-md border border-graphite bg-obsidian p-4" data-animate>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="mono text-xs text-slate">{project.id}</p>
                  <h2 class="mt-1 text-sm font-[510] text-snow">{project.title}</h2>
                </div>
                <StatusPill status={project.status} />
              </div>
              <p class="mt-3 text-sm leading-6 text-fog">{project.type}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
